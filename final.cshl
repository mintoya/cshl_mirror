int : type : @sint(32);

iter :: struct{ 
  decl :ast;
  cont :ast;
  init :ast;
};
each ::fn((name:ast , array : []t) , result : iter){
  result = [ 
    .decl = @noExpand{ name := array[_i]; _i = _i + 1; } , 
    .cont = @noExpand{ _i < array.len; } , 
    .init = @noExpand{ _i : int = 0; } , 
  ];
};
for :fn((cnd : iter), fn((ast) , ast)):{
  return fn((body : ast) , ast){
    return 
      @noExpand(
        {
          cnd.init;
          @while(cnd.cont  , {
            cnd.decl; body;
          });
        }
      );
  };
};


str : type : []@sint(8);

main : fn(( []str ),int);
main = fn(( arg : []str ),r : int = 0){
  for each(arg,args) print(arg);
};
