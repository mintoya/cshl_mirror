type:@type():@type();
any:type: @any();
ast:type: @ast();
int:type: @int(); // signed bigint

i64:type:@sint(64);
i32:type:@sint(32);
i16:type:@sint(16);
i8 :type:@sint(8);

u64:type:@uint(64);
u32:type:@uint(32);
u16:type:@uint(16);
u8 :type:@uint(8);

if! : fn((args : ast)) ;
if! = fn((args : ast)) {
  call :: args."op"."call";
  cond :: call."left";
  bodies:: call."right";

  has_else :: @typeof(bodies."not") == ast;

  @if(has_else, {
    1000 * 1000;
    @if(cond, @uqot(bodies."left"));
    @if(not cond, @uqot(bodies."right"));
  });

  @if(not has_else, {
    @if(cond, @uqot(bodies));
  });
};

while! :: fn((args : ast)){
  @while(
    args."op"."call"."left",
    args."op"."call"."right",
  );
};



if! (1) {
  5 * 10;
};

j :=  1000*100;
j = j - 1;
j = j - 1;
j = j - 1;
j = j - 1;
j = j - 1;
j = j - 1;
while! j {j = j - 1;};
