type : @type() : @type();
any:type: @any();
ast:type: @ast();
int:type: @int(); // signed bigint

i64:type:@sint(64);
i32:type:@sint(32);
i16:type:@sint(16);
i8 :type:@sint(8);

u64:type:@uint(64);
u32:type:@uint(32);
u16:type:@uint(16);
u8 :type:@uint(8);

j:u64=100;
square ::fn((i:any) , any) { return i*i; };
j=square(j) ;

while:fn((cond_body : ast)):{
  @uqot({ 
    @while(
     cond_body.op.call.left,
     cond_body.op.call.right
    ) 
  ;});
};
if :: fn((cond_body : ast)) {
  iter := cond_body.op.call.left;
  @qot(
    while (iter) {  
      cond_body.op.call.right;
      iter = 0;
    }
  );
};

while j j = j - 1;

