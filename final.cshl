type:@type():@type();
any:type: @any();
ast:type: @ast();
int:type: @int();

macro::fn((args:ast),ast);

if! : macro : {
  call :: args."op"."call";
  cond :: call."left";
  bodies:: call."right";

  @if(
    @typeof(bodies."not") == ast,
    return @qot({
      @if(cond, bodies."left");
      @if(not cond, bodies."right");
    })
  );

  return @qot({
    @if(cond, bodies);
  });
};

while! :: macro{
  return @qot(@while(
    args."op"."call"."left",
    args."op"."call"."right",
  ));
};



if! 1 { 5 * 10;};
if!(1( { 5 * 10;}));
i := 68;
while! i {i = i - 1;};

