ast :: @ast();
type :: @type();

int : type : @sint(32);

iter :: struct{ 
  decl :ast;
  cont :ast;
  init :ast;
};
each ::fn((name:ast , array : []t) , iter){
  // noExpand will ignore first level of scope punctuation
  id : ast : name.id;
  return [ 
    .init = @noExpand{ i : @uint(64) = 0; } , 
    .cont = @noExpand{ i < array.len; } , 
    .decl = @noExpand{ id := array[i]; i = i + 1; } , 
  ];
};
for :fn((cnd : iter), fn((ast) , ast)):{
  return fn((body : ast) , ast){
    return 
      @noExpand(
        { // these brackcets will also be insserted
          @expand(cnd.init);
          @while(@expand(cnd.cont),{
            @expand(cnd.decl);
            body;
          });
        }
      );
  };
};


str : type : []@sint(8);

main : fn(( []str ),int);
main = fn(( arg : []str ),r : int = 0){
  for each(arg,args) print(arg);
};

