#!/bin/nu
{
  CompileFlags : { Add:[
    "-x","c",
    "-std=c2y",
    "-fdefer-ts",
    "-I",("deps" | path expand),
    "-D","CLANGD_EDITING"
  ],
  Compiler : "clang"
  },
} 
| to yaml 
| save -f .clangd;

{
  path      :("tsversion/parser.so" | path expand ),
  highlights:("tsversion/queries/highlights.scm" | path expand ),
  folds     :("tsversion/queries/folds.scm" | path expand ),
  extension :"cshl",
} 
| to json
| save -f .tsconfig.json;
