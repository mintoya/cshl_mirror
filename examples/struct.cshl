type ~~ @type();
i32 ~~ @sint(32);

point ~type~ @struct{
  scale ~~ 1;
  Self ~type~ @this();

  x ~ i32;
  y ~ i32;

  @id("+") ~~ fn((self~Self,other~Self), Self,
    return @construct(Self,
      x~~ self.x * scale + other.x,
      y~~ self.y * scale + other.y
    ));
  // first arg is a type, so this is basically a static menber of the type
  @id("()") ~~ fn((type,x~i32,y~i32), Self,{
    r~Self ;
    r.x = x;
    r.y = y;
    return r;
  });
};


a~~ point(1,2);
b~~ point(3,4);
//  analogous
c~point~ a."+"(a,b);
// for functions, pointer can only use colon for call 
d~point~ a:"+" b ;
e~point~ a + b;

