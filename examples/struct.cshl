type  ~~ @type();
void  ~~ @void();
any ~~ @any();
i ~~@sint;
u ~~@uint;

point ~type~ @struct{
  Self ~type~ @this();
  x ~ i 32;
  y ~ i 32;
  @id("+") ~~ @fn (self~Self,other~Self),Self,{
    r ~Self;
    r.x = self.x+other.x;
    r.y = self.y+other.y;
    return r;
  };
  @id("/") ~~ @fn (self~Self,scale~i 32),Self,{
    self.x = self.x / scale;
    self.y = self.y / scale;
    return self;
  };
  /*
  @id("=") ~~ @fn (self ~@ptr Self,other ~any),Self,{
    @if (@typeof(other) == Self), {
      return self:copy(other);
    };
    // zig style function overloading & such
  };
  copy ~~ @fn (self~@ptr Self , other~Self),Self,{
    self.x = other.x;
    self.y = other.y;
    return @at self;
  };
  
  @id("@init") ~~ @fn (type),void,{;};
  @id("@deinit") ~~ @fn (type),void,{;};
  */
};


ia ~i 32~1;
ib ~i 32~2;
a ~point;a.x=ia;a.y=ib;
b ~point;b.x=ib;b.y=ia;
c ~point~ (a + b) / 3;

