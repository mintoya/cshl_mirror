// ast member access semantics:
//   - accessing a non-active field yields the empty ast, which is falsy
//   - `ast."op"` returns the node itself when it is an op with that operator
//   - ast ids compare against string literals
//   - `ast.opleft` / `ast.opright` are the two operands of an op
//   - `ast[N]` accesses the n-th statement of a block
a ~~ 1;
b ~~ 2;
q ~~ @qot(a + b);

left ~~ q.opleft;           // the id `a`
is_a ~~ left == "a";        // id vs string literal
@if(is_a, r1 ~~ 1, r1 ~~ 2);

empty1 ~~ q.opright.opright; // .opright on an id -> empty ast
z ~= 0;
@if(empty1, z = 1, z = 2);  // empty ast is falsy -> z stays 2

callish ~~ @qot(a "x");     // juxtaposition is a call
is_call ~~ callish."()";    // op with () -> the node itself, truthy
@if(is_call, r4 ~~ 1, r4 ~~ 2);

blk ~~ @qot({1; 2; 3;});
first ~~ blk[0];            // n-th statement inside a block
@if(first, r2 ~~ 1, r2 ~~ 2);

selfb ~~ blk.block;         // `.block` yields the node itself if it's a block
@if(selfb, r3 ~~ 1, r3 ~~ 2);
