type ~~ @type();
ast ~type~ @ast();
any ~type~ @any();
int ~type~ @int();
fn ~~ @fn((a~ast,r~ast),any,
  return @fn((b~ast),any,return @qot @fn(
    @uqot(a),
    @uqot(r),
    @uqot(b)
)));

add2 ~~ fn (a~any,b~any),any return a + b;
add3 ~~ fn (a~any,b~any,c~any),any { 
  return a + b + c; 
};

arr ~~ fn (i~int),any 
  return fn (t~type),type 
    return @arr(i,t);
i32 ~type~ @sint(32);
i32a ~type~ arr(5)i32;
