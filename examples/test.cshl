type ~~ @type();
s32  ~~ @sint(32);
ref  ~~ @refT;

// a closure is a struct: one member per capture and a "()" overload.
// the capture is explicit, so a ref member aliases its source.
counter ~s32 = 0;

add ~type~ @struct{
  Self ~type~ @this();
  n ~ (ref s32);
  @id("()") ~~ @fn (self ~Self, j ~s32), s32, {
    total ~(ref s32) = self.n;
    total = total + j;
    return total;
  };
};

make ~~ @fn (n ~(ref s32)), add, {
  c ~add;
  c.n = n;
  return c;
};

result ~~ @fn (), s32, {
  c ~add = make(counter);
  c(3);
  return c(4);
};

result();
