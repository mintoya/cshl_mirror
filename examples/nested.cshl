i ~~ @sint;
i128 ~~ i(128);
outer ~~ @fn (run ~i128,in ~i128),i128,{
  run = run + 1;

  odd ~~ @fn (a ~i128, o ~i128),i128,{
    return outer(a,o * 3 + 1);
  };
  even ~~ @fn (a ~i128, e ~i128),i128,{
    return outer(a,e / 2);
  };
  resolve ~~ @fn (r ~i128, n ~i128),i128,{
    @if((n == 1), (return r - 1));
    @if((n band 1), (return odd(r,n)));
    return even(r,n);
  };
  return resolve(run,in);
};

resutl ~= outer(0,63728127);
//resutl ~= outer(0,27);
