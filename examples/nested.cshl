i ~~ @sint;
outer ~~ @fn (run ~(i 32),in ~(i 32)),(i 32),{
  run = run + 1;
  odd ~~ @fn (a ~(i 32),o ~(i 32)),(i 32),
   (return outer(a,o * 3 + 1));
  even ~~ @fn (a ~(i 32),e ~(i 32)),(i 32),
   (return outer(a,e / 2));
  @if((in == 1), (return run - 1));
  @if((in band 1), (return odd(run,in)));
  return even(run,in);
};

outer(0,1000);
