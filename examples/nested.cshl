i ~~ @sint;
i64 ~~ i(64);
outer ~~ @fn (run ~i64,in ~i64),i64,{
  run = run + 1;
  odd ~~ @fn (a ~i64, o ~i64),i64, return(outer a,o * 3 + 1);
  even ~~ @fn (a ~i64, e ~i64),i64, return(outer a,e / 2);
  resolve ~~ @fn (r ~i64, n ~i64),i64,{
    @if((n == 1), (return r - 1));
    @if((n band 1), (return odd(r,n)));
    return even(r,n);
  };
  return resolve(run,in);
};

resutl ~= outer(0,63728127);
//resutl ~= outer(0,27);
