type ~~ @type();
ast  ~~ @ast();
any  ~~ @any();
int ~~ @int();
inline ~~ @inlineast();
i8  ~~ @sint 8;
i16 ~~ @sint 16;
i32 ~~ @sint 32;
i64 ~~ @sint 64;
u8  ~~ @uint 8;
u16 ~~ @uint 16;
u32 ~~ @uint 32;
u64 ~~ @uint 64;
bool ~~ @bool();
void ~~ @void();
fn  ~~ @fn (a ~ast),inline,{
  return 
    @qot @fn(
      @uqot(a."()".opleft),
      @uqot(a."()".opright."()".opleft),
      @uqot(a."()".opright."()".opright),
    );
};
@closure ~~ fn (caps ~ast, args ~ast, ret ~ast, body ~ast) any {
  capture ~~ @fn (mode ~@int(), inst ~ast, c ~ast), ast, {
    cif (mode == 0)
      return @qot (@uqot(c.name) ~ @uqot(c.type));
    cif (mode == 1)
      return @qot (@uqot(@ast_op(".", inst, c.name)) = @uqot(c.value));
    return @qot( @uqot(c.name) ~ @uqot(c.type) = @uqot(@ast_op(".", @qot(self), c.name)));
  };
  captures ~~ fn (caps ~ast, inst ~ast, mode ~@int(), i ~@int()) ast {
    cif (caps[i] == @qot()) {
      return @qot [];
    } else return @qot {
      @uqot(@apply(capture, mode, inst, caps[i]));
      @splice(@apply(captures, caps, inst, mode, i + 1));
    };
  };
  return @uqot@qot {
    ClosureType ~type~ @struct {
      Self ~type~ @this();
      @splice @apply(captures, caps, @qot(inst), 0, 0);
      @id("()") ~~ fn (self ~Self, @splice(args)) (@uqot(ret)) {
        @splice @apply(captures, caps, @qot(inst), 2, 0);
        @splice body ;
      };
    };
    inst ~ClosureType;
    @splice @apply(captures, caps, @qot(inst), 1, 0);
    inst;
  };
};
closure ~~ fn (a ~ast) any {
  return 
    @uqot @qot @closure(
      @uqot(a."()".opleft),
      @uqot(a."()".opright."()".opleft),
      @uqot(a."()".opright."()".opright.opleft),
      @uqot(a."()".opright."()".opright.opright),
    );
};
if  ~~ fn (a ~ast) inline {
  call ~ast~ a."()";
  cond ~ast~ call.opleft;
  rest ~ast~ call.opright;

  @cif((rest."()".opright."()".opleft == "else"), {
    then ~ast~ rest.opleft;
    else ~ast~ rest.opright."()".opright;

    return @qot @if(
      @uqot(cond),
      @uqot(then),
      @uqot(else)
    );
  });

  return @qot @if(
    @uqot(cond),
    @uqot(rest)
  );
};
cif  ~~ fn (a ~ast) inline {
  call ~ast~ a."()";
  cond ~ast~ call.opleft;
  rest ~ast~ call.opright;

  @cif((rest."()".opright."()".opleft == "else"), {
    then ~ast~ rest.opleft;
    else ~ast~ rest.opright."()".opright;

    return @qot @cif(
      @uqot(cond),
      @uqot(then),
      @uqot(else)
    );
  });

  return @qot @cif(
    @uqot(cond),
    @uqot(rest)
  );
};
while ~~ fn (a ~ast) inline {
  cond ~ast~ a."()".opleft;
  body ~ast~ a."()".opright;
  return @qot @loop{
    @if (@uqot(cond)),
      (@uqot(body)),
      (break());
  };
};
some_state ~~ @sint(32);
getstate ~~ fn () (@typeof(some_state)) 
  return (some_state = some_state + 1);
arr ~~ fn (i~int) any 
  return (fn (T~type) type 
    return (@arr(i,T)));

@struct{
  inline  ~~ inline;
  bool  ~~ bool;
  type  ~~ type;
  ast ~~ ast ;
  any ~~ any ;
  int ~~ int;
  i8  ~~ i8;
  i16 ~~ i16;
  i32 ~~ i32;
  i64 ~~ i64;
  u8  ~~ u8;
  u16 ~~ u16;
  u32 ~~ u32;
  u64 ~~ u64;
  void  ~~ void;
  getstate ~~ getstate;

  fn ~~ fn;
  @closure ~~ @closure;
  closure ~~ closure;
  if ~~ if;
  while ~~ while;
  cif ~~ cif;
  arr ~~ arr;
};
