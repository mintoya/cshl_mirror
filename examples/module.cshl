type ~~ @type();
ast  ~~ @ast();
any  ~~ @any();
int ~~ @int();
inline ~~ @inlineast();
i8  ~~ @sint 8;
i16 ~~ @sint 16;
i32 ~~ @sint 32;
i64 ~~ @sint 64;
u8  ~~ @uint 8;
u16 ~~ @uint 16;
u32 ~~ @uint 32;
u64 ~~ @uint 64;
bool ~~ @bool();
true ~@comptime(bool)~1;
false~@comptime(bool)~0;
null ~@comptime(@struct{});
void ~~ @void();
fn  ~~ @fn (a ~ast),inline,(return @qot @fn(
  @uqot(a."()".opleft),
  @uqot(a."()".opright."()".opleft),
  @uqot(a."()".opright."()".opright),
));
@closure ~~ fn (caps ~ast, args ~ast, ret ~ast, body ~ast) any {
  capture ~~ @fn (mode ~@int(), inst ~ast, c ~ast), ast, {
    cif (mode == 0)
      return @qot (@uqot(c.name) ~ @uqot(c.type));
    cif (mode == 1)
      return @qot (@uqot(@ast_op(".", inst, c.name)) = @uqot(c.value));
    return @qot( @uqot(c.name) ~ @uqot(c.type) = @uqot(@ast_op(".", @qot(self), c.name)));
  };
  captures ~~ fn (caps ~ast, inst ~ast, mode ~@int(), i ~@int()) ast {
    cif (caps[i] == @qot()) {
      return @qot [];
    } else return @qot {
      @uqot(@apply(capture, mode, inst, caps[i]));
      @splice(@apply(captures, caps, inst, mode, i + 1));
    };
  };
  return @uqot@qot {
    ClosureType ~type~ @struct {
      Self ~type~ @this();
      @splice @apply(captures, caps, @qot(inst), 0, 0);
      @id("()") ~~ fn (self ~Self, @splice(args)) (@uqot(ret)) {
        @splice @apply(captures, caps, @qot(inst), 2, 0);
        @splice body ;
      };
    };
    inst ~ClosureType;
    @splice @apply(captures, caps, @qot(inst), 1, 0);
    inst;
  };
};
closure ~~ fn (a ~ast) any {
  return 
    @uqot @qot @closure(
      @uqot(a."()".opleft),
      @uqot(a."()".opright."()".opleft),
      @uqot(a."()".opright."()".opright.opleft),
      @uqot(a."()".opright."()".opright.opright),
    );
};
if  ~~ fn (a ~ast) inline {
  call ~ast~ a."()";
  cond ~ast~ call.opleft;
  rest ~ast~ call.opright;

  @cif((rest."()".opright."()".opleft == "else"), {
    then ~ast~ rest.opleft;
    else ~ast~ rest.opright."()".opright;

    return @qot @if(
      @uqot(cond),
      @uqot(then),
      @uqot(else)
    );
  });

  return @qot @if(
    @uqot(cond),
    @uqot(rest)
  );
};
cif  ~~ fn (a ~ast) inline {
  call ~ast~ a."()";
  cond ~ast~ call.opleft;
  rest ~ast~ call.opright;

  @cif((rest."()".opright."()".opleft == "else"), {
    then ~ast~ rest.opleft;
    else ~ast~ rest.opright."()".opright;

    return @qot @cif(
      @uqot(cond),
      @uqot(then),
      @uqot(else)
    );
  });

  return @qot @cif(
    @uqot(cond),
    @uqot(rest)
  );
};
while ~~ fn (a ~ast) inline {
  @cif (a."()"), { 
    cond ~ast~ a."()".opleft;
    body ~ast~ a."()".opright;
    return @qot @loop{
      @if (@uqot(cond)),
        (@uqot(body)),
        (break());
    };
  },{
    return @qot @loop{
      @if (@uqot(a)),
        (0),
        (break());
    };
  };
};
not ~~ fn (in ~bool) bool return in bxor 1;
some_state ~ @sint(32);
getstate ~~ fn () (@typeof(some_state)) 
  return (some_state = some_state + 1);
arr ~~ fn (i~int) any 
  return (fn (T~type) type 
    return (@arr(i,T)));
? ~~ fn (t~type) type return @struct {
    Self ~~ @this();
    isnnull  ~bool;
    value    ~t;
    @id("as") ~~ fn (this~Self , t~type) any {
      cif (t == bool) {
        return this.isnnull; 
      } else  @error(); // not bound to anything, regular unbound id
    };
    @id("=") ~~ fn (this~@refT(Self), o~any) void {
      cif (@typeof(o) == @typeof(null)) {
        this.isnnull = false;
      } else cif (@typeof(o) == Self) {
        this.isnnull = o.isnnull;
        if o.isnnull (this.value = o.value);
      } else {
        this.value = o;
        this.isnnull = true;
      };
    };
    orelse ~~ fn (this~ast , a~ast) inline {
      return @qot {
        _self ~= @uqot(this);
        _result ~ @typeof(_self.value);
        if _self (_result = _self.value)
          else (_result = @uqot a);
        _result;
      };
    };
};


array_of ~~ fn (T~type, A~type) (@comptime bool) {
  info ~~ @typeinfo(A).array;
  cif (not info) { return false; }
  else { return info.elem == T; };
};
came_from ~~ fn (a~type ,b ~any) (@comptime bool ) {
  tia ~~ @typeinfo(a);
  tib ~~ @typeinfo(b);
  cif (not tia.struct) { return false; }
  else cif (not tib.fn) { return false; }
  else {return tia.struct.namespace.fn.0 == tib.fn.0;};
};
@struct{
  inline  ~~ inline;
  bool  ~~ bool;
  type  ~~ type;
  ast ~~ ast ;
  any ~~ any ;
  int ~~ int;
  i8  ~~ i8;
  i16 ~~ i16;
  i32 ~~ i32;
  i64 ~~ i64;
  u8  ~~ u8;
  u16 ~~ u16;
  u32 ~~ u32;
  u64 ~~ u64;
  void  ~~ void;
  getstate ~~ getstate;

  fn ~~ fn;
  @closure ~~ @closure;
  closure ~~ closure;
  if ~~ if;
  while ~~ while;
  cif ~~ cif;
  arr ~~ arr;
  ? ~~ ?;
  true  ~~ true;
  false ~~ false;
  null ~~ null;
  not ~~ not;
  came_from ~~ came_from;
  array_of ~~ array_of;
};
