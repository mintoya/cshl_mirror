@using @import "module.cshl";

arr ~~ fn (i~int) any 
  return (fn (T~type) type 
    return (@arr(i,T)));
arr(3) i8;

! ~~ fn (T~type) type {
  return @struct{
    Self~type~@this();
    has_err ~bool;
    data ~ @union{
      err_text ~(@ptr @sint 8);
      result ~T;
    };
    try ~~ fn (self ~ast) (@inlineast()) {
      return @qot{
        this ~~ @uqot(self);
        if this.has_err {
          RT ~type~ @returntype();
          @cif(@typeinfo(RT).struct.namespace.fn.0 == @typeinfo(!).fn.0, {
            error ~RT;
            error.has_err = 1 as bool;
            error.data.err_text = this.data.err_text;
            return error;
          }, {
            // TODO: do something about it
          });
        };
        this.data.result;
      };
    };
  };
};
otherfn ~~ fn () (! i32) {
  result ~@returntype();
  result.has_err = 1;
  result.data.err_text = @where "error"[0];
  return result;
};
main ~~ fn () (! void) {otherfn():try();};
it ~~ main();
// it.data.err_text;
it.has_err;

