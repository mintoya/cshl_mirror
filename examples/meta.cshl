@using @import "module.cshl";

arr(3) i8;

! ~~ fn (T~type) type {
  return @struct{
    Self~type~@this();
    has_err ~bool;
    data ~ @union{
      err_text ~(@ptr @sint 8);
      result ~T;
    };
    catch ~~ fn (self ~ast) inline {;};
    try ~~ fn (self ~ast) inline return @qot {
        this ~~ @uqot(self);
        if this.has_err {
          RT ~type~ @returntype();
          cif (@typeinfo(RT).struct) {
            cif (
              @typeinfo(RT).struct.namespace.fn.0 ==
              @typeinfo(!).fn.0
            ) {
              error ~RT;
              error.has_err = true;
              error.data.err_text = this.data.err_text;
              return error;
            } else call_to_unbound_thing();
          } else call_to_unbound_thing();
        };
        this.data.result;
    };
  };
};
otherfn ~~ fn () (! i32) {
  result ~@returntype();
  result.has_err = 1;
  result.data.err_text = @where "error"[0];
  return result;
};
main ~~ fn () (! void) {
  otherfn():try();
  result ~@returntype();
  result.has_err = false;
  return result;
};
result ~~ main();
result.has_err;
