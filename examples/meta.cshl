@using @include "examples/macros.cshl";

! ~~ fn (T~type) type {
  return @struct{
    Self~type~@this();
    has_err ~bool;
    data ~ @union{
      err_text ~(@ptr @sint 8);
      result ~T;
    };
    try ~~ fn (self ~ast) (@inlineast()) {
      return @qot{
        this ~~ @uqot(self);
        if this.has_err {
          @cif (
            @typeinfo(@returnT()).struct.namespace.parent == @typeinfo(@typeof(!)).fn.namespace),
          {
            result ~ @returnT();
            result.has_err = 1;
            result.data.err_text = this.data.err_text;
            return result;
          },{
            // panic or something
          };
        };
        this.data.result;
      };
    };
  };
};

f1 ~~ fn () (! void) {;};
main ~~ fn (times ~int) (! void) {
  @cif(
    (times),
    (return main(times - 1))
  );
  f1():try();
};
main(2); // just generates n+1 specializations of main
