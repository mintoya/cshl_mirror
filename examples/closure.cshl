type  ~~ @type();
s32 ~~ @sint(32);
ast ~~ @ast();
any ~~ @any();


pieces ~~ @fn (values ~ast, inst ~ast, mode ~@int(), i ~@int()), ast, {
  piece ~~ @fn (mode ~@int(), inst ~ast, v ~ast), ast, {
    (@cif (mode == 0),
      (return @qot (@uqot(v.name) ~ @uqot(v.type))));
    (@cif (mode == 1), 
      (return @qot (@uqot(@ast_op(".", inst, v.name)) = @uqot(v.value))));
    return @qot (@uqot(v.name) ~@uqot(v.type) = @uqot(@ast_op(".", @qot(self), v.name)));
  };
  @cif(
    (i < @ast_len(values)),
    (return @qot {
      @uqot(@apply(piece, mode, inst, @ast_at(values, i)));
      @splice(@apply(pieces, values, inst, mode, i + 1));
    }),
    (return @qot [])
  );
};
@closure ~~ @fn (values ~ast, args ~ast, ret ~ast, body ~ast), any, {
  return @uqot@qot {
    ClosureType ~type~ @struct {
      Self ~type~ @this();
      @splice @apply(pieces, values, @qot(inst), 0, 0);
      @id("()") ~~ @fn((self ~Self, @splice(args)), @uqot(ret), {
        @splice @apply(pieces, values, @qot(inst), 2, 0);
        @splice body ;
      });
    };
    inst ~ClosureType;
    @splice @apply(pieces, values, @qot(inst), 1, 0);
    inst;
  };
};

counter ~s32 = 0;

add ~~ @closure [n ~(@refT s32)=counter], (j ~ s32), s32,
  (return  (n = n + j)); 

result ~~ @fn (), s32,
  (add 3|>add _|>return _);

a~~result();
b~~result();
