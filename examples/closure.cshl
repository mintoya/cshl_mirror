@using @import "module.cshl";

// @cinclude lands in the file prologue, ahead of the generated functions.
@cinclude "stdio.h";

counter ~i32 = 0;

add ~~ closure [n ~(@refT i32) = counter] (j ~i32) i32
  return (n = n + j);

result ~~ fn () i32 {
  add(3);
  return add(3);
};

printint ~~ fn (i~i32) void 
  @cout "printf(\"%i\\n\",arg0);";
printint(result());
printint(result());
