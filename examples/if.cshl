a:= 1;
@if(
  a,
  2,
);
@if(
  a,
  {2;},
  {3;}
);
@while(
  a,
  a = a - 1
);

ast :: @ast();
if :: fn((a: ast), ast) {
  call :ast: a."()";
  cond :ast: call.left;
  rest :ast: call.right;

  @if(rest."()", {
    then :ast: rest.left;
    else :ast: rest.right."()";

    @if( else, return @qot @if(
            @uqot(cond),
            @uqot(then),
            @uqot(else.right)
         )
    );
  });

  return @qot(
    @if(
      @uqot(cond),
      @uqot(rest)
    )
  );
};

i :: if 1 (2)
  else (3);
