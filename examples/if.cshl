ast ~~ @ast();
any ~~ @any();

if  ~~ @fn (a ~ast),ast,{
  call ~ast~ a."()";
  cond ~ast~ call.opleft;
  rest ~ast~ call.opright;

  @cif((rest."()".opright."()".opleft == "else"), {
    then ~ast~ rest.opleft;
    else ~ast~ rest.opright."()".opright;

    return @qot @if(
      @uqot(cond),
      @uqot(then),
      @uqot(else)
    );
  });

  return @qot @if(
    @uqot(cond),
    @uqot(rest)
  );
};
cnd ~~ @fn (a ~any,b ~any,c ~(@typeof b)),(@typeof b),{
  // if' (a) (return b) else (return c);
  // analogous to
  @id("if")'((a)((return(b))(else(return(c)))));
};

one ~= cnd (1),
  1,
  0;
// one == 1
one = cnd (one),
  3,
  2;
// one == 3
