a:= 1;
@if(
  a,
  2,
);
@if(
  a,
  {2;},
  {3;}
);
@while(
  a,
  a = a - 1
);

ast :: @ast();
if :: fn((a: ast), ast) {
  call :ast: a."()";
  cond :ast: call.left;
  rest :ast: call.right;

  @if(rest."()", {
    then_block :ast: rest.left;
    else_call :ast: rest.right."()";

    @if(else_call, {
      return @qot(
        @if(
          @uqot(cond),
          @uqot(then_block),
          @uqot(else_call.right)
        )
      );
    });
  });

  return @qot(
    @if(@uqot(cond), @uqot(rest))
  );
};

i :: if 1 (2)
  else (3);
