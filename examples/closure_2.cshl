any ~~ @any();
ast ~~ @ast();
type ~~ @type();
i32 ~~ @sint(32);

@closure ~~ @fn((
  caps  ~ast,
  args  ~ast,
  ret   ~type,
  body  ~ast,
),any,{
  expand_closure_arg ~~ @fn((a~ast),ast,{
    dcl  ~~ a.decl;
    return @qot(@uqot(dcl.name) ~ @uqot(dcl.type););
  });
  arglist ~~ @qot( (@id("Self"),@ast_uwr(args)) ); // (Self, n~i32)
  structlist ~~ @qot(@struct{ @ast_apply(expand_closure_arg,@ast_uwr(caps)) }); // closures ~ @struct{i~(@refT i)}
  [[]] as 
    @uqot @qot @struct{
      Self~~@this();
      captures ~@uqot(structlist);
      @id("()")~~@fn((Self),ret,{});
    };
});

i ~i32~ 0;
add ~~@closure([i~(@refT i)~i],(n~i32),i32,{ return (i = i + n); });

add(5) 
  |> add(_)
  |> add(_)
  ; // 20
