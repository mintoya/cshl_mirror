type ~~ @type();
bool ~~ @bool();
void ~~ @void();
ast ~~ @ast();
any ~~ @any();
int ~~ @int();
inline ~~ @inlineast();
fn  ~~ @fn (a ~ast),inline,{
  return 
    @qot @fn(
      @uqot(a."()".opleft),
      @uqot(a."()".opright."()".opleft),
      @uqot(a."()".opright."()".opright),
    );
};
if  ~~ fn (a ~ast) inline {
  call ~ast~ a."()";
  cond ~ast~ call.opleft;
  rest ~ast~ call.opright;

  @cif((rest."()".opright."()".opleft == "else"), {
    then ~ast~ rest.opleft;
    else ~ast~ rest.opright."()".opright;

    return @qot @if(
      @uqot(cond),
      @uqot(then),
      @uqot(else)
    );
  });

  return @qot @if(
    @uqot(cond),
    @uqot(rest)
  );
};
while  ~~ fn (a ~ast) inline {
  cond ~ast~ a."()".opleft;
  rest ~ast~ a."()".opright;
  return @qot{
    @loop{
      @if(@uqot(cond) , @uqot(rest),break());
    };
  };
};
arr ~~ fn (i~int) any
  (return fn (T~type) type 
    (return @arrof(T,i)));

i8  ~~ @sint 8 ;
i16 ~~ @sint 16;
i32 ~~ @sint 32;
i64 ~~ @sint 64;
u8  ~~ @uint 8 ;
u16 ~~ @uint 16;
u32 ~~ @uint 32;
u64 ~~ @uint 64;
