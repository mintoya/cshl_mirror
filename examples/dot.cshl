@using @import "module.cshl";

Point ~type~ @struct{
  Self ~type~ @this();
  x ~i32;
  y ~i32;
  @id(".") ~~ fn (this~@refT(Self) ,l~ast)( @refT(i32) ){
    cif (l == "x") {
      return @ref @rawget(this, "y");
    } else cif (l == "y") {
      return @ref @rawget(this, "x");
    } else return @ref @rawget(this, "x");
  };
  @id("+") ~~ fn (
    this~Self,
    other~Self,
  )Self{
    result ~Self;
    result.x = other.x + this.x;
    result.y = other.y + this.y;
    return result;
  };
};

a ~Point;
