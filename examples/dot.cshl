type ~~ @type();
ast ~~ @ast();
any ~~ @any();
i32 ~type~ @sint(32);
fn  ~~ @fn (a ~ast),@inlineast(),{
  return 
    @qot @fn(
      @uqot(a."()".opleft),
      @uqot(a."()".opright."()".opleft),
      @uqot(a."()".opright."()".opright),
    );
};
Point ~type~ @struct{
  Self ~type~ @this();
  x ~i32;
  y ~i32;
  @id(".") ~~ fn (this~@refT(Self) ,l~ast)( @refT(i32) ){
    @cif((l == "x"),(return @ref(@rawget(this, "x"))));
    @cif((l == "y"),(return @ref(@rawget(this, "y"))));
  };
  @id("+") ~~ fn (
    this~Self,
    other~Self,
  )Self{
    result ~Self;
    result.x = other.x + this.x;
    result.y = other.y + this.y;
    return result;
  };
};
a ~Point;
a.x = 5;
a.y = 4;
a;
