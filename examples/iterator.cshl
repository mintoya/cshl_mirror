@using @import "module.cshl";

range ~~ fn (start~i32, end~i32) any {
  result ~ @struct{
    Self  ~~ @this();
    state ~ i32;
    end   ~ i32;
    next ~~ fn (this~@refT(Self)) (@struct{valid~bool;yield~i32;}) {
      result ~ @returntype();
      result.valid = this.state < this.end;
      if (result.valid) {
        result.yield = this.state;
        this.state = this.state + 1;
      };
      return result;
    };
  };
  result.state = start;
  result.end   = end;
  return result;
};
filter ~~ fn (cnd ~ast) inline {
  return @qot{
    rt ~ @struct{
      Self ~~ @this();
      state ~ @typeof _;
      next ~~ fn (this~@refT(Self)) (@struct{valid~bool;yield~i32;}) {
        result ~= this.state:next();
        while (
          result.valid  
          and (result.yield |> @uqot(cnd) bxor 1)
          ) ( result = this.state:next() );
        ret    ~@returntype();
        ret.valid= result.valid;
        ret.yield= result.yield;
        return ret;
      };
    };
    rt.state = _;
    rt;
  };
};
sum ~i32~0;

each ~~ fn (block ~ast) inline {
  return @qot {
    it ~= _;
    curr ~= it:next();
    while (curr.valid) {
      curr.yield |> @uqot(block);
      curr = it:next();
    };
  };
};

range(0 , 6) |> filter { _ band 1 ;} |> each { sum = sum + _; };
sum;
