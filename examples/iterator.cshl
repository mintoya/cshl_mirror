@using @import "module.cshl";

range ~~ fn (start~i32, end~i32) any {
  result ~ @struct{
    Self  ~~ @this();
    state ~ i32;
    end   ~ i32;
    next ~~ fn (this~@refT(Self)) (? i32) {
      result ~ @returntype();
      if (this.state < this.end) {
        result.isnnull = true;
        result.value = this.state;
        this.state = this.state + 1;
      } else (result.isnnull = 0);
      return result;
    };
  };
  result.state = start;
  result.end   = end;
  return result;
};



filter ~~ fn (cnd ~ast) inline return @qot{
  rt ~ @struct{
    Self ~~ @this();
    state ~ @typeof _;
    next ~~ fn (this~@refT(Self)) any {
      result ~= this.state:next();
      while (
        result as bool
        and (result.value |> @uqot(cnd))
      ) (result = this.state:next());
      return result;
    };
  };
  rt.state = _;
  rt;
};
map ~~ fn (body ~ast) inline return @qot {
  rt ~ @struct{
    Self ~~ @this();
    state ~ @typeof _;
    next ~~ fn (this~@refT(Self)) any {
      result ~= this.state:next();
      if (result as bool) (result.value = (result.value |> @uqot body));
      return result;
    };
  };
  rt.state = _;
  rt;
};

iterate ~~ fn () inline return @qot while (_:next() as bool);

sum ~i32~0;
range(0 , 6) 
  |> filter { not (_ band 1);} 
  |> map    { _ * 3;}
  |> map    { sum = sum + _ ;}
|> iterate();
sum;
