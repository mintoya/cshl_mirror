i ~~ @sint;
i32 ~~ i(32);
outer ~~ @fn (n ~i32),i32,{
  isodd ~~ @fn (n ~i32),i32;
  iseven ~~ @fn (n ~i32),i32;
  isodd ~~ @fn (n ~i32),i32,{
    @if((n == 0), (return 0));
    return iseven(n - 1);
  };
  iseven ~~ @fn (n ~i32),i32,{
    @if((n == 0), (return 1));
    return isodd(n - 1);
  };
  return isodd(n);
};
result ~= outer(7);
result == 1;
