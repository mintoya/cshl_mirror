  and ((big / 2) == 55) and ((big % 2) == 1) and ((big bxor 7) == 104)
  and ((big band 112) == 96) and ((big bor 7) == 111)
  and ((big shl 4) == 1776) and ((neg shr 127) == (0 - 1));
