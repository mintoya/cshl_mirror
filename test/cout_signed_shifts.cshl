negative ~i64 = 0 - 1;
one ~i64 = 1;
last ~i64 = 63;
whole ~u64 = 18446744073709551615;
large_unsigned ~u64 = 64;
((x shl 1) == (0 - 6)) and ((x shr 1) == (0 - 2))
  and ((x shl back) == (0 - 2)) and ((x shr back) == (0 - 6))
  and ((x shl large) == 0)
  and ((negative shl last) == minimum)
  and ((negative shl minimum) == (0 - 1))
  and ((one shr minimum) == 0)
  and ((whole shr large_unsigned) == 0)
  and ((whole shl large_unsigned) == 0);
